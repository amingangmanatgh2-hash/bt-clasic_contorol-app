{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMIN Bluetooth Control",
  "version": "3.0.0",
  "identifier": "com.amin.bluetoothcontrol",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AMIN Bluetooth Control",
        "width": 1360,
        "height": 940,
        "minWidth": 900,
        "minHeight": 680,
        "backgroundColor": "#090d16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Bluetooth Classic controller for Arduino",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Persian"
        ]
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
